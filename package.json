{
  "name": "shop-e2e-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript UI and API tests for the Medusa commerce platform (storefront, admin, Store and Admin REST API).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --project=a11y",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "coverage:matrix": "node scripts/coverage-matrix.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sut:up": "make -C ../shop-sut up",
    "sut:smoke": "make -C ../shop-sut smoke",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.1",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
